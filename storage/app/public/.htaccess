# تعطيل تنفيذ أي سكربتات في مجلد التخزين العام
<FilesMatch "\.(php|phtml|phar|pl|py|cgi|asp|aspx|sh|bash|html|htm|svg|js)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

Options -ExecCGI
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
